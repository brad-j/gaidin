# System unit for the gaidin VM. Installed by deploy/install.sh.
[Unit]
Description=gaidin personal agent
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/gaidin/config.json

[Service]
User=gaidin
Group=gaidin
WorkingDirectory=/var/lib/gaidin/app
Environment=GAIDIN_CONFIG=/etc/gaidin/config.json
# The browser's Chromium, which install.sh installs when the settings give it profiles.
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/gaidin/browsers
# The Node install.sh pins.
ExecStart=/opt/gaidin/node/bin/node --no-warnings src/main.ts serve
Restart=on-failure
RestartSec=5
UMask=0077

# Tools run in a bubblewrap sandbox (src/sandbox.ts); this limits the server itself. It can't change
# its own code or read the deploy key. ProtectKernelTunables is left off: it stops bubblewrap from
# mounting a fresh /proc, and the server isn't root, so it can't write /proc/sys anyway.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/gaidin
ReadOnlyPaths=/var/lib/gaidin/app
InaccessiblePaths=/var/lib/gaidin/deploy
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
