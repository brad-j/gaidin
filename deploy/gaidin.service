# systemd user unit for running gaidin on egwene. Install:
#   ln -s ~/westwood/Projects/Software/gaidin/deploy/gaidin.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now gaidin
# Node is Pi's bundled one; update the path when it changes.
[Unit]
Description=gaidin personal agent

[Service]
WorkingDirectory=%h/westwood/Projects/Software/gaidin
ExecStart=%h/.local/share/pi-node/node-v22.23.2-linux-x64/bin/node --no-warnings --env-file-if-exists=.env src/server.ts
Restart=on-failure
RestartSec=5
UMask=0077

[Install]
WantedBy=default.target
