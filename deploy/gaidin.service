# systemd user unit for running gaidin from a checkout, as your own user. Edit the paths, then:
#   ln -s "$PWD/deploy/gaidin.service" ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now gaidin
# User units stop at logout unless lingering is on (loginctl enable-linger). Settings come from
# gaidin.json in the checkout; deploy/config.example.json shows the shape.
[Unit]
Description=gaidin personal agent

[Service]
WorkingDirectory=%h/gaidin
ExecStart=/usr/bin/env node --no-warnings src/main.ts serve
Restart=on-failure
RestartSec=5
UMask=0077

[Install]
WantedBy=default.target
