{
  "name": "gaidin",
  "version": "1.0.0",
  "description": "Personal agent on Pi Durable",
  "bin": {
    "gaidin": "src/main.ts"
  },
  "scripts": {
    "gaidin": "node --no-warnings --env-file-if-exists=.env src/main.ts",
    "serve": "node --no-warnings --env-file-if-exists=.env src/main.ts serve",
    "ask": "node --no-warnings --env-file-if-exists=.env src/main.ts ask",
    "watch": "node --no-warnings --env-file-if-exists=.env src/main.ts watch",
    "doctor": "node --no-warnings --env-file-if-exists=.env src/main.ts doctor",
    "check": "tsc && pnpm lint && pnpm test",
    "lint": "oxlint --deny-warnings src test e2e",
    "test": "node --no-warnings --test test/*.test.ts"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.10.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.10.1",
  "type": "module",
  "dependencies": {
    "@earendil-works/chord": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0",
    "@oxlint/plugins": "1.87.0",
    "@types/node": "^26.6.4",
    "oxlint": "1.87.0",
    "playwright-core": "1.64.0",
    "typescript": "^7.0.2"
  }
}
